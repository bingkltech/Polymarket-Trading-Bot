{
  "name": "polymarket-multi-strategy-platform",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "bin": {
    "bot": "dist/cli.js"
  },
  "scripts": {
    "incubate:reset": "node scripts/incubate_reset.js && npm run dev",
    "dev": "tsx src/cli.ts start --config config.yaml",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js start --config config.yaml",
    "test": "vitest run",
    "lint": "eslint . --ext .ts",
    "format": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "semgrep": "semgrep scan --config .semgrep.yml src/",
    "security:scan": "semgrep scan --config .semgrep.yml src/",
    "ocr": "ocr",
    "ocr:review": "ocr review",
    "ocr:scan": "ocr scan src/"
  },
  "dependencies": {
    "@polymarket/clob-client": "^5.8.1",
    "@polymarket/clob-client-v2": "^1.2.0",
    "better-sqlite3": "^12.6.2",
    "commander": "^12.1.0",
    "dotenv": "^18.0.5",
    "ethers": "^5.7.2",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.0",
    "yaml": "^2.4.5"
  },
  "devDependencies": {
    "@alibaba-group/open-code-review": "^1.12.11",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
